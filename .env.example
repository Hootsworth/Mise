# Optional server port (defaults to 3456)
PORT=3456

# Optional default provider id: gemini | meta | openai | claude | openrouter | ollama
DEFAULT_PROVIDER=

# Dish photography policy:
# By default Mise uses free open image endpoints (Openverse, Wikimedia Commons, TheMealDB, Wikipedia).
# AI image generation is strictly opt-in in the UI (or "Generate with AI" button on a recipe).
# Set IMAGE_PROVIDER=auto (default), open (force open-only), or off (disable automatic photos).
IMAGE_PROVIDER=auto

# Optional comma-separated extra allowed CORS origins (for custom domains on Cloudflare Worker)
ALLOWED_ORIGINS=

# Google Gemini (set as GitHub Secrets / .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Meta AI — Meta Model API (https://api.meta.ai/v1; accepts META_API_KEY or MODEL_API_KEY)
META_API_KEY=
META_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
META_BASE_URL=

# OpenAI (set as GitHub Secrets / .env)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Anthropic Claude (set as GitHub Secrets / .env)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenRouter (set as GitHub Secrets / .env)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5

# Local Ollama (local Node server only; only shown as configured when OLLAMA_HOST or OLLAMA_MODEL is set)
OLLAMA_HOST=
OLLAMA_MODEL=llama3.2
