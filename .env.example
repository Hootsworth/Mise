# Optional server port (defaults to 3456)
PORT=3456

# Optional default provider id: gemini | meta | openai | claude | openrouter | ollama
DEFAULT_PROVIDER=

# Image generation provider: auto | gemini | meta | openai | openrouter | wikimedia | off
# "auto" prefers the active text provider (if it supports images), then Gemini/OpenAI/Meta/OpenRouter, then Wikimedia Commons fallback.
IMAGE_PROVIDER=auto

# Google Gemini (set as GitHub Secrets / .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Meta AI — Meta Model API (https://api.meta.ai/v1; accepts META_API_KEY or MODEL_API_KEY)
META_API_KEY=
META_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
# Optional custom base URL (defaults to https://api.meta.ai/v1)
META_BASE_URL=

# OpenAI (set as GitHub Secrets / .env)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Anthropic Claude (set as GitHub Secrets / .env)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenRouter (set as GitHub Secrets / .env)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5

# Local Ollama (only shown as configured when OLLAMA_HOST or OLLAMA_MODEL is set)
OLLAMA_HOST=
OLLAMA_MODEL=llama3.2
